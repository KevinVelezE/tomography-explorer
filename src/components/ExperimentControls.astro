---
import { VIEW_COUNTS } from '../engine/config';
---
<section id="experiment-controls" class="experiment-controls" aria-label="Experiment parameters">
  <div class="base-controls">
    <label for="phantom">Phantom<select id="phantom"><option value="asymmetric">Disk with inclusion</option><option value="disk">Uniform disk</option></select></label>
    <label for="views">Projection views<select id="views">{VIEW_COUNTS.map(n => <option value={n} selected={n === 180}>{n}</option>)}</select></label>
  </div>
  <div class="control-group" id="geometry-controls">
    <label for="angle">Projection angle <output id="angle-value" for="angle">0.0°</output><input id="angle" type="range" min="0" max="179" value="0" step="1" /></label>
    <label for="detector" id="detector-control">Detector position <output id="detector-value" for="detector">0.000</output><input id="detector" type="range" min="0" max="127" value="64" step="1" /></label>
  </div>
  <div class="control-group" id="filter-controls" hidden>
    <label id="filter-choice-control" for="filter">Displayed filter<select id="filter"><option value="ramp">Ramp</option><option value="hann">Hann</option></select></label>
    <label for="alpha">Hann cutoff α <output id="alpha-value" for="alpha">0.65</output><input id="alpha" type="range" min="0.1" max="1" step="0.01" value="0.65" /></label>
  </div>
  <div class="control-group" id="noise-controls" hidden>
    <label for="noise">Noise level <output id="noise-value" for="noise">0.000</output><input id="noise" type="range" min="0" max="0.05" step="0.001" value="0" /></label>
    <label for="seed">Noise seed<input id="seed" type="number" min="0" max="4294967295" step="1" value="42" inputmode="numeric" /></label>
  </div>
</section>
